# Supabase — Settings → API.
# À copier dans .env.local (jamais commité) et dans les variables
# d'environnement Vercel (Production, Preview ET Development).
#
# Supabase nomme désormais ses clés « publishable » et « secret ». Les noms de
# variables ci-dessous sont ceux que lit le code : ne pas les renommer.

NEXT_PUBLIC_SUPABASE_URL=https://mrqhesvdazroyqqcwprh.supabase.co

# Clé « publishable » (sb_publishable_...). Destinée au navigateur : elle ne
# donne accès qu'à ce que la RLS autorise.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Clé « secret » (sb_secret_...). SERVEUR UNIQUEMENT : elle contourne la RLS.
# Jamais de préfixe NEXT_PUBLIC_ devant — Next l'inlinerait dans le JavaScript
# envoyé au navigateur, et n'importe qui pourrait lire les mains de tous les
# joueurs.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
